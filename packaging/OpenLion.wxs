<!-- OpenLion installer. Built by build-release.ps1: wix build -d Version=x.y.z -bindpath stage=<staged app> -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- perUserOrMachine (WiX sets ALLUSERS=2, MSIINSTALLPERUSER=1): installs for the current
       user into %LOCALAPPDATA%\Programs\OpenLion without needing administrator rights. -->
  <Package Name="OpenLion" Manufacturer="OpenLion" Version="$(var.Version)"
           UpgradeCode="{6F1D3C52-8E0B-4E3A-9C1B-0A57E1D4C0B1}" Scope="perUserOrMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenLion is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="OpenLion.ico" SourceFile="..\app\src\OpenLion\Assets\OpenLion.ico" />
    <Property Id="ARPPRODUCTICON" Value="OpenLion.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hyprninja/OpenLion" />
    <Property Id="ARPHELPLINK" Value="https://github.com/hyprninja/OpenLion/issues" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenLion" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="OpenLionShortcut" Name="OpenLion" Description="Make new maps for your Holden iQ navigation"
                  Target="[INSTALLFOLDER]OpenLion.exe" WorkingDirectory="INSTALLFOLDER" Icon="OpenLion.ico" />
        <RegistryValue Root="HKCU" Key="Software\OpenLion" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.stage)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
